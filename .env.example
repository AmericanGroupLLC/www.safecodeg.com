# Copy to .env and fill in real values locally. Never commit .env or real
# credentials to this file — see .gitignore (lines 11-15).

# Supabase project used by server/contactRouter.ts to save contact form
# submissions. SUPABASE_SERVICE_KEY is a service-role key: it bypasses Row
# Level Security and must stay server-side only — never expose it under a
# VITE_ prefix or in any client-bundled code.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Supabase Realtime + PostgREST — the 6D "shared stage" collaboration
# feature (client/src/dimensions/transport, ARCHITECTURE-DIMENSIONS.md §6).
# The anon key is public by design and ships in the browser bundle; its
# safety rests entirely on the RLS policies in
# supabase/migrations/0001_dimensions_room_state.sql. Both empty ⇒
# createTransport() returns the null transport and the UI reports
# "unconfigured" — that is a safe, expected default, not a broken build.
# Never put the service-role key here under a VITE_ prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
